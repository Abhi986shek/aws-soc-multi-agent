# --- LLM (Anthropic via Strands) -------------------------------------------
# Anthropic API key. Never commit the real value.
ANTHROPIC_API_KEY=
# Fast model id for stages 1-2 (cheap tier, e.g. a Haiku-class model).
MODEL_FAST=
# Smart model id for stages 3-4 and sidecars (Sonnet/Opus-class model).
MODEL_SMART=

# --- AWS --------------------------------------------------------------------
# Region used for all AWS clients (boto3).
AWS_REGION=us-east-1
# DynamoDB table where incident tickets are persisted.
DYNAMODB_TABLE=soc_tickets

# --- Queues (optional; used only if SQS between-stage handoff is enabled) ---
SQS_DETECTION_URL=
SQS_ENRICHMENT_URL=
SQS_TRIAGE_URL=
SQS_RESPONSE_URL=

# --- Redis (rolling correlation window for stage 2) ------------------------
REDIS_URL=redis://localhost:6379/0
CORRELATION_WINDOW_SECONDS=3600

# --- Alerting ---------------------------------------------------------------
# Slack incoming-webhook URL for pipeline notifications.
SLACK_WEBHOOK_URL=
# Slack channel id used by the approval gate for destructive actions.
SLACK_APPROVAL_CHANNEL=
# Approval strategy for destructive actions:
#   "deny"         - fail closed, no destructive action ever runs (default)
#   "auto_approve" - dev/test convenience; approve everything automatically
#   "manual"       - poll <cwd>/approvals/<trace_id>_<action>.decision file
SLACK_APPROVAL_MODE=deny
# Timeout (seconds) for manual-mode approval polling before failing closed.
SLACK_APPROVAL_TIMEOUT_SECONDS=300
# SES From address (verified in SES) used to send priority-incident emails.
EMAIL_FROM=
# Comma-separated list of recipient addresses for priority-incident emails.
EMAIL_TO=

# --- Mitigation (no hardcoded ARNs / URIs; configure per environment) ------
# IAM policy ARN used to disable a principal (e.g. arn:aws:iam::aws:policy/AWSDenyAll).
DENY_ALL_POLICY_ARN=
# S3 URI for forensic log backups (e.g. s3://my-forensics-backup/).
FORENSICS_BACKUP_S3_URI=
# Comma-separated list of sensitive bucket names / ARNs.
S3_SENSITIVE_BUCKETS=

# --- Detection tuning -------------------------------------------------------
# Max events pulled per CloudTrail lookup_events call.
CLOUDTRAIL_LOOKBACK_MAX_RESULTS=50
# Off-hours window (UTC hours, half-open interval [start, end)).
OFF_HOURS_START_HOUR=0
OFF_HOURS_END_HOUR=8

# --- Safety switches --------------------------------------------------------
# When true, mitigation calls are logged but not executed.
DRY_RUN=true
# Master switch for automated mitigation - must be true for stage 4 to act.
AUTO_MITIGATION_ENABLED=false
# Below this triage confidence, destructive actions require human approval.
TRIAGE_CONFIDENCE_THRESHOLD=0.8

# --- Logging ----------------------------------------------------------------
# Log verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Log format: "text" for humans, "json" for Splunk/ELK ingestion of the app's own logs.
LOG_FORMAT=text

# --- Offline / testing ------------------------------------------------------
# When true: stub out AWS/Redis/LLM calls and run against canned fixtures.
MOCK_MODE=false

# --- MITRE ATT&CK -----------------------------------------------------------
# URL to the enterprise-attack STIX bundle. Downloaded once and cached.
MITRE_STIX_URL=https://raw.githubusercontent.com/mitre/cti/master/enterprise-attack/enterprise-attack.json
# Where the STIX bundle is cached on disk.
MITRE_STIX_CACHE_PATH=.cache/mitre-enterprise-attack.json

# --- Threat feeds (optional; blank = feed disabled, silent no-op) -----------
# AbuseIPDB API key.
ABUSEIPDB_API_KEY=
# GreyNoise Community API key.
GREYNOISE_API_KEY=
# TTL for the in-process IP-reputation cache.
THREAT_FEED_CACHE_TTL_SECONDS=3600

# --- PagerDuty (optional; blank = disabled, silent no-op) ------------------
# PagerDuty Events API v2 integration key (routing key). Empty = disabled.
PAGERDUTY_ROUTING_KEY=

# --- Splunk HEC (optional; blank = disabled, silent no-op) ------------------
# Splunk HTTP Event Collector URL (e.g. https://splunk.example.com:8088/services/collector).
SPLUNK_HEC_URL=
# HEC token. Never commit the real value.
SPLUNK_HEC_TOKEN=
# Target index (defaults to "main" if left blank).
SPLUNK_INDEX=
# Verify TLS cert on HEC endpoint (set false only for self-signed dev deployments).
SPLUNK_VERIFY_TLS=true

# --- TheHive (case management) ---------------------------------------------
# TheHive base URL (e.g. https://thehive.mycorp.com). Empty = disabled.
THEHIVE_URL=
# TheHive personal API key. Never commit the real value.
THEHIVE_API_KEY=
# TheHive organisation name used for the API calls.
THEHIVE_ORGANISATION=
# Traffic Light Protocol for cases: 0=WHITE, 1=GREEN, 2=AMBER, 3=RED.
THEHIVE_TLP=2
# Permissible Actions Protocol for cases: same 0-3 scale.
THEHIVE_PAP=2
# Verify TLS cert on TheHive endpoint (set false only for self-signed dev deployments).
THEHIVE_VERIFY_TLS=true
